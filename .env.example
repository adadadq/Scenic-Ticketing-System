APP_NAME=scenic-ticket-api
APP_VERSION=0.1.0
APP_ENV=development
PAYMENT_PROVIDER=mock
SMS_PROVIDER=disabled
ADMIN_EXPORT_STORAGE_PROVIDER=local
ADMIN_EXPORT_STORAGE_DIR=.data/admin-exports
ADMIN_EXPORT_QUEUE_PROVIDER=database
ADMIN_EXPORT_ALERT_PROVIDER=disabled
DB_HOST=127.0.0.1
DB_PORT=15432
DB_NAME=scenic_ticket
DB_USER=scenic_app
DB_PASSWORD=replace-with-password
DB_SSLMODE=disable
SESSION_COOKIE_NAME=scenic_session
ADMIN_SESSION_COOKIE_NAME=scenic_admin_session
CSRF_COOKIE_NAME=scenic_csrf
# If CSRF_COOKIE_NAME changes, set frontend VITE_CSRF_COOKIE_NAME to the same value.
# VITE_CSRF_COOKIE_NAME=scenic_csrf
CSRF_HEADER_NAME=x-csrf-token
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_PROVIDER=memory
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
MOCKPAY_CALLBACK_SECRET=replace-with-mockpay-callback-secret
MOCKPAY_CALLBACK_TOLERANCE_SECONDS=300
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1):\d+$
# 前端读取 CSRF Cookie 时，浏览器页面 hostname 与 API_BASE_URL hostname 必须一致。
# 例如前端打开 http://localhost:5173 时，API 也用 http://localhost:<port>。
# APP_ENV=production 时必须：
# - COOKIE_SECURE=true
# - DB_PASSWORD 设置为真实密钥
# - MOCKPAY_CALLBACK_SECRET 设置为真实回调密钥
# - CORS_ALLOWED_ORIGINS 设置为明确 HTTPS origin，例如 https://tickets.example.com
# - CORS_ALLOWED_ORIGINS 不允许 *、localhost、127.0.0.1、路径或查询参数
# - CORS_ALLOWED_ORIGIN_REGEX 留空，避免继续使用本地开发正则
# - PAYMENT_PROVIDER 当前只能是 mock，真实支付渠道需后续接入后再启用
# - SMS_PROVIDER 当前只能是 disabled，真实短信需后续接入后再启用
# - LOGIN_RATE_LIMIT_PROVIDER 当前只能是 memory，全局限流需后续接入 Redis、网关或负载均衡层
# - ADMIN_EXPORT_STORAGE_PROVIDER 当前只能是 local，生产对象存储需后续接入后再启用
# - ADMIN_EXPORT_QUEUE_PROVIDER 当前只能是 database，外部队列需后续接入后再启用
# - ADMIN_EXPORT_ALERT_PROVIDER 当前只能是 disabled，失败告警需后续接入后再启用
